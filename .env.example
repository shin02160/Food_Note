# Copy to .env for local use; set these in Vercel for deployment.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=4226d8c5-8de1-812a-abad-000b3a03e68e
# Optional for sharing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
PORT=3000
# Optional overrides for the two Notion data sources.
NOTION_VISIT_DATA_SOURCE_ID=
NOTION_RESTAURANT_DATA_SOURCE_ID=

# Optional Place Notes sources (built-in defaults are used when omitted).
NOTION_PLACE_DATA_SOURCE_ID=
NOTION_BRAND_DATA_SOURCE_ID=
NOTION_PHOTO_DATA_SOURCE_ID=
NOTION_WISH_DATA_SOURCE_ID=
# Optional private view: set a strong random password (16+ characters) and APP_SECRET.
APP_PASSWORD=
